{
  "ibhagwan/fzf-lua",
  dependencies = { "nvim-tree/nvim-web-devicons" },
  config = function()
    require("fzf-lua").setup({ "fzf-native" })
  end,
  keys = {
    { "<leader><space>", "<cmd>FzfLua files<cr>", desc = "Find Files (Fzf)" },
    { "<leader>fg", "<cmd>FzfLua live_grep<cr>", desc = "Live Grep (Fzf)" },
  },
}
